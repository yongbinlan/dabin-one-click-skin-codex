# Local runtime state can contain a user's image; never commit it.
runtime/state.json
runtime/controller.pid
runtime/*.log

# Local diagnostics.
logs/
*.log

# Local rollback copies.
*.bak

# Local icon revisions and project handoff record.
assets/dabin-codex-skin-icon-v*.ico
assets/dabin-codex-skin-icon-v*.png
docs/HANDOFF.md

# Python bytecode generated by local release checks.
__pycache__/

# Private launcher selection and atomic-write temporary files.
runtime/launcher-selection.json
runtime/launcher-selection.json.*.tmp
